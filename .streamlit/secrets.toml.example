# Copy this file to .streamlit/secrets.toml (gitignored, never commit real values)
# and fill in your Supabase project's URL + anon key from:
# Supabase Dashboard > Project Settings > API

SUPABASE_URL = "https://xxxxxxxxxxxx.supabase.co"
SUPABASE_KEY = "eyJhbGciOi..."

# Optional: gates the whole app behind a single shared password.
# Leave this line out entirely to run without a login screen (e.g. local dev).
APP_PASSWORD = "choose-a-strong-password"
